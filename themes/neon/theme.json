{
  "id": "neon",
  "name": "Neon",
  "version": "1.0.0",
  "author": "conn",
  "license": "MIT",
  "description": "conn's original look: deep navy, cyan accent, periwinkle chrome, an orange lead and a violet advisor.",
  "modes": ["dark"],
  "accent": "fixed",
  "fonts": ["Chakra Petch", "JetBrains Mono"],
  "tokens": {
    "dark": {
      "bg": "#05060d",
      "panel": "#0b0e1c",
      "raise": "#222e62",
      "sunk": "#000000",
      "hover": "rgba(127,156,255,.1)",
      "line": "rgba(127,156,255,.18)",
      "line2": "rgba(127,156,255,.3)",
      "tx": "#d6dcf0",
      "bright": "#ffffff",
      "mu": "#98a2bd",
      "onac": "#021a22",
      "ac": "#5ad7ff",
      "ac-soft": "rgba(90,215,255,.1)",
      "ac-line": "rgba(90,215,255,.55)",
      "ok": "#6fd6a0",
      "warn": "#ffd166",
      "bad": "#ff6b6b",
      "idle": "#8e9bc6",
      "info": "#7f9cff",
      "k-bug": "#ff6b6b",
      "k-epic": "#b69cff",
      "k-task": "#7fd4ff",
      "k-story": "#6fd6a0",
      "k-subtask": "#3fe0b4",
      "teammate": "#ff9ad5",
      "role-lead": "#ff9a5a",
      "role-agent": "#7f9cff",
      "role-advisor": "#b69cff",
      "edge": "#7f9cff",
      "stall": "#ff9a5a",
      "font-ui": "'Chakra Petch', system-ui",
      "font-mono": "'JetBrains Mono', ui-monospace",
      "case": "uppercase",
      "tracking": ".14em",
      "radius": "4px",
      "led": "circle",
      "border-style": "solid",
      "lift": "0 10px 30px rgba(0,0,0,.55)",
      "glow": "1",
      "blur": "0px",
      "motion": "power",
      "font-body": "mono",
      "backdrop": "grid",
      "backdrop-size": "44px",
      "backdrop-strength": ".5",
      "orbs": "bright",
      "backdrop-scan": "1",
      "header": "glint",
      "stage": "hud",
      "stage-backing": "0",
      "card-fill": "wash",
      "card-corner": "round",
      "card-frame": "hairline",
      "card-marks": "brackets",
      "card-stripe": "on",
      "card-rim": "1",
      "card-bloom": "0",
      "card-shadow": "halo",
      "glyph-arrow": "triangle",
      "glyph-bullet": "triangle",
      "glyph-sep": "slash",
      "glyph-brand": "conn-tube",
      "wire-style": "line",
      "wire-width": "2px",
      "wire-head": "arrow",
      "wire-crawl": "on",
      "wire-flow": "packets",
      "wire-glyphs": "binary",
      "wire-signal": "roles",
      "wire-speed": "1",
      "tree-orbits": "on",
      "node-beat": "on",
      "orbs-tint": "roles",
      "card-cut": "10px",
      "card-glow": "0",
      "chrome": "authored",
      "text-glow": "0",
      "cursor": "bar",
      "hover-lift": "on",
      "meter": "segmented",
      "focus": "#b9ccff",
      "meter-track": "#243063",
      "meter-lit": "#a9bcff",
      "meter-lead": "#ffb27f"
    }
  },
  "effects": []
}
