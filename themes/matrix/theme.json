{
  "id": "matrix",
  "name": "Matrix",
  "version": "1.0.0",
  "author": "Casey Clayton",
  "license": "MIT",
  "description": "Green glyph rain behind glass panels, and white hex streaming along the agent tree: the Matrix is green, the real world steel blue, an alert red.",
  "modes": ["dark"],
  "accent": "fixed",
  "fonts": ["Share Tech Mono"],
  "tokens": {
    "dark": {
      "bg": "#010a04",
      "panel": "rgba(2,16,7,.72)",
      "raise": "rgba(0,40,14,.8)",
      "sunk": "rgba(0,6,2,.6)",
      "hover": "rgba(0,255,65,.08)",
      "line": "rgba(0,255,65,.2)",
      "line2": "rgba(0,255,65,.4)",
      "tx": "#c9ffd6",
      "bright": "#eafff0",
      "mu": "#6fa8ff",
      "onac": "#00140a",
      "ac": "#00ff41",
      "ac-soft": "rgba(0,255,65,.1)",
      "ac-line": "rgba(0,255,65,.5)",
      "ok": "#00ff41",
      "warn": "#d8ffb0",
      "bad": "#ff4d5e",
      "idle": "#5b8fb0",
      "info": "#8ec5ff",
      "k-bug": "#ff4d5e",
      "k-epic": "#b9a2ff",
      "k-task": "#6fa8ff",
      "k-story": "#7dffa0",
      "k-subtask": "#2fe0b0",
      "teammate": "#8affd9",
      "role-lead": "#b4ff6e",
      "role-agent": "#6fa8ff",
      "role-advisor": "#b9a2ff",
      "edge": "#00ff41",
      "stall": "#ffb454",
      "font-ui": "'Share Tech Mono', system-ui",
      "font-mono": "'Share Tech Mono', ui-monospace",
      "case": "lowercase",
      "tracking": ".08em",
      "radius": "2px",
      "led": "diamond",
      "border-style": "solid",
      "lift": "0 10px 30px rgba(0,0,0,.6)",
      "glow": ".4",
      "blur": "5px",
      "motion": "calm",
      "font-body": "mono",
      "backdrop": "none",
      "orbs": "none",
      "backdrop-scan": "0",
      "header": "frost",
      "stage": "plain",
      "card-fill": "glass",
      "card-corner": "notch",
      "card-frame": "hairline",
      "card-marks": "gutter",
      "card-stripe": "off",
      "card-rim": ".8",
      "card-bloom": "0",
      "card-shadow": "none",
      "glyph-arrow": "arrow",
      "glyph-bullet": "prompt",
      "glyph-sep": "bar",
      "glyph-brand": "prompt",
      "stage-backing": ".88",
      "node-beat": "off",
      "tree-orbits": "off",
      "wire-speed": ".8",
      "wire-signal": "bright",
      "wire-glyphs": "hex",
      "wire-flow": "glyphs",
      "wire-crawl": "off",
      "wire-head": "arrow",
      "wire-width": "1px",
      "wire-style": "line",
      "card-glow": "0",
      "card-cut": "10px",
      "meter": "segmented",
      "chrome": "styled"
    }
  },
  "effects": [{ "name": "rain", "options": { "density": 0.6 } }]
}
